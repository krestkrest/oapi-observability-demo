// Observer starts observation and returns a derived context and a completion
// callback. The callback receives the HTTP status (0 if unavailable) and error.
// Implementations must support concurrent calls and return a non-nil callback.
type Observer interface {
    Start(ctx context.Context, operation string) (context.Context, func(statusCode int, err error))
}

// ObservedClient instruments only ClientWithResponsesInterface methods.
type ObservedClient struct {
    next ClientWithResponsesInterface
    observer Observer
}

var _ ClientWithResponsesInterface = (*ObservedClient)(nil)

// NewObservedClient wraps a client with an observer. Both must be non-nil.
func NewObservedClient(next ClientWithResponsesInterface, observer Observer) *ObservedClient {
    return &ObservedClient{next: next, observer: observer}
}

